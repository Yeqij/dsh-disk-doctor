{
  "name": "dsh-disk-doctor",
  "version": "0.1.0",
  "description": "Disk accounting for DeepSeek Harness with a reversible cleanup: where the gigabytes went, what is regenerable, and what is your content. It never deletes — a confirmed cleanup renames files into the plugin's own quarantine and can be undone with one click. · DSH 空间体检：看清占用构成；从不删除，确认后的清理只是改名移动到隔离区，可一键撤销。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./scan": "./lib/scan.js",
    "./report": "./lib/report.js",
    "./targets": "./lib/targets.js",
    "./locate": "./lib/locate.js",
    "./serve": "./lib/serve.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "USAGE.md",
    "TRIAL-INSTALL.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "dsh-disk-doctor contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yeqij/dsh-disk-doctor.git"
  },
  "homepage": "https://github.com/Yeqij/dsh-disk-doctor#readme",
  "bugs": {
    "url": "https://github.com/Yeqij/dsh-disk-doctor/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --import ./test/stubs/register.mjs --test test/locate.test.mjs test/scan.test.mjs test/plugin.test.mjs test/client.test.mjs",
    "test:locate": "node --test test/locate.test.mjs",
    "test:scan": "node --test test/scan.test.mjs",
    "test:plugin": "node --import ./test/stubs/register.mjs --test test/plugin.test.mjs",
    "test:client": "node --test test/client.test.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "disk",
    "storage",
    "cleanup",
    "disk-usage",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-disk-doctor",
    "summary": "只读统计 DeepSeek Harness 的磁盘占用：右侧栏可视化面板 + 分类构成与 Top N 明细，不删除、不联网；清理只是移动到隔离区且可一键撤销。 · Disk accounting for DSH: a right-sidebar panel showing where the gigabytes went and what is regenerable. Never deletes; cleanup renames into a quarantine folder and is undoable.",
    "surfaces": [
      "host",
      "web"
    ],
    "categories": [
      "磁盘",
      "观测"
    ],
    "permissions": {
      "network": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.2 || 0.1.0-rc.3 || 0.1.0-rc.6 || 0.1.0-rc.7 || 0.1.0-rc.8 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.2 || 0.1.5-alpha.1 || 0.1.5-alpha.2 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.5-rc.3 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1 || 0.1.7-alpha.2 || 0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
